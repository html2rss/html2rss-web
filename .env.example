# html2rss-web environment configuration
# Copy this file to .env and configure your secrets:
#   cp .env.example .env

# REQUIRED FOR PRODUCTION:
# Secret key for encrypting session cookies and state (minimum 32 characters).
# Generate with: openssl rand -hex 32
HTML2RSS_SECRET_KEY=

# REQUIRED FOR WEB UI FEED CREATION:
# Access token required by the web application to submit and create feeds.
# Paste this token into the web UI when prompted (minimum 16 characters).
# Generate with: openssl rand -hex 32
HTML2RSS_ACCESS_TOKEN=

# HERO GOLDEN PATH (URL-to-RSS auto-sourcing):
# Keep enabled to allow pasting any webpage URL to generate an RSS feed.
AUTO_SOURCE_ENABLED=true

# COMPANION SCRAPER:
# URL of the companion Botasaurus scraper API service in docker-compose.
BOTASAURUS_SCRAPER_URL=http://botasaurus:4010

# OPTIONAL: Token for automated uptime monitoring via GET /health (minimum 16 characters)
# HEALTH_CHECK_TOKEN=

# OPTIONAL: Error monitoring via Sentry
# SENTRY_DSN=
# SENTRY_ENABLE_LOGS=false
# BOTASAURUS_SENTRY_DSN=
