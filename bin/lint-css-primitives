#!/usr/bin/env ruby
# frozen_string_literal: true

# Fail closed when composition CSS redefines shared primitives or uses raw type scale values.

COMPOSITION_FILES = [
  'frontend/src/styles/main.css',
  'public/feed.css'
].freeze

ALL_STYLE_FILES = [
  *COMPOSITION_FILES,
  'public/shared-ui.css'
].freeze

RSS_XSL_PATH = 'public/rss.xsl'

PRIMITIVE_REDEF = /
  \.(btn|input|ui-card|ui-eyebrow|ui-item|layout-stack|brand-lockup|ui-actions|ui-display-title)
  (--[a-z0-9-]+|__[a-z0-9-]+)?
  \s*([,{]|$)
/x
RAW_LETTER_SPACING = /^\s*letter-spacing:\s*[0-9.-]/
RAW_FONT_SIZE = /^\s*font-size:\s*(clamp\(|[0-9])/
INLINE_STYLE_ELEMENT = /<style[\s>]/
INLINE_STYLE_ATTRIBUTE = /\sstyle=/

def matching_lines(files, pattern)
  files.flat_map do |path|
    File.readlines(path).each_with_index.filter_map do |line, index|
      next unless line.match?(pattern)

      "#{path}:#{index + 1}:#{line}"
    end
  end
end

def matching_substring(files, needle)
  files.flat_map do |path|
    File.readlines(path).each_with_index.filter_map do |line, index|
      next unless line.include?(needle)

      "#{path}:#{index + 1}:#{line}"
    end
  end
end

def fail_with(hits, message)
  return if hits.empty?

  warn hits.join
  warn message
  exit 1
end

fail_with(
  matching_lines(COMPOSITION_FILES, PRIMITIVE_REDEF),
  'main.css / feed.css must not redefine shared primitives; ' \
  'move them to public/shared-ui.css or override via CSS vars on a composition host'
)

fail_with(
  matching_substring(ALL_STYLE_FILES, '--state-frame-'),
  'Banned --state-frame-* tokens detected'
)

fail_with(
  matching_lines(COMPOSITION_FILES, RAW_LETTER_SPACING),
  'Use letter-spacing tokens instead of raw values in main.css / feed.css'
)

fail_with(
  matching_lines(COMPOSITION_FILES, RAW_FONT_SIZE),
  'Use font-size tokens instead of raw values in main.css / feed.css'
)

rss_xsl_lines = File.readlines(RSS_XSL_PATH)
fail_with(
  rss_xsl_lines.each_with_index.filter_map do |line, index|
    next unless line.match?(INLINE_STYLE_ELEMENT) || line.match?(INLINE_STYLE_ATTRIBUTE)

    "#{RSS_XSL_PATH}:#{index + 1}:#{line}"
  end,
  'public/rss.xsl must be CSP-safe: no inline <style> elements or style= attributes'
)

puts 'CSS primitive ownership checks passed!'
