{
  "name": "html2rss-frontend",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --port 4001 --host",
    "build": "vite build",
    "preview": "vite preview --port 4001 --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "openapi:generate": "openapi-ts",
    "openapi:verify": "openapi-ts && git diff --exit-code -- src/api/generated",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit --reporter=verbose",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:ci": "pnpm run test:run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "baseline-browser-mapping": "^2.11.20",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
